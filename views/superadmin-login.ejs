<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DocOnCall - Super Admin Access</title>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-blue: #5B7FFF;
            --primary-purple: #7C5FFF;
            --dark-bg: #0A0E1A;
            --card-bg: #141824;
            --border-color: #1F2937;
            --text-primary: #FFFFFF;
            --text-secondary: #A0A8C1;
            --error-red: #EF4444;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: linear-gradient(135deg, #1d1f24 0%, #1a1f35 100%);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-card {
            background: rgba(20, 24, 36, 0.9);
            backdrop-filter: blur(20px);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 40px;
            max-width: 440px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
            text-align: center;
        }

        .shield-icon {
            font-size: 48px;
            margin-bottom: 16px;
        }

        h1 {
            font-family: 'Sora', sans-serif;
            font-size: 24px;
            margin-bottom: 8px;
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        p.subtitle {
            color: var(--text-secondary);
            font-size: 14px;
            margin-bottom: 28px;
        }

        .form-group {
            text-align: left;
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }

        input[type="password"] {
            width: 100%;
            padding: 14px 16px;
            background: #0A0E1A;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            color: var(--text-primary);
            font-size: 15px;
            outline: none;
            transition: border-color 0.2s ease;
        }

        input[type="password"]:focus {
            border-color: var(--primary-blue);
        }

        .error-message {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid var(--error-red);
            color: #FCA5A5;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 20px;
            text-align: left;
        }

        button.btn-login {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        button.btn-login:hover {
            opacity: 0.95;
            transform: translateY(-1px);
        }

        .back-link {
            display: inline-block;
            margin-top: 20px;
            color: var(--text-secondary);
            font-size: 13px;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .back-link:hover {
            color: var(--primary-blue);
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="shield-icon">🛡️</div>
        <h1>Super Admin Access</h1>
        <p class="subtitle">Authenticate to manage doctor approvals and platform credentials.</p>

        <% if (locals.error && error) { %>
            <div class="error-message">
                <%= error %>
            </div>
        <% } %>

        <form action="/superadmin/login" method="POST">
            <div class="form-group">
                <label for="adminPassword">Master Admin Password</label>
                <input type="password" id="adminPassword" name="password" placeholder="Enter admin access key" required autofocus>
            </div>
            <button type="submit" class="btn-login">Authenticate Console</button>
        </form>

        <a href="/" class="back-link">← Return to Homepage</a>
    </div>
</body>
</html>
